{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Clusters": {
    "WebFrontend-Cluster": {
      "Destinations": {
        "Destination0": {
          "Address": "https+http://web-frontend"
        }
      }
    },
    "RestApi-Cluster": {
      "Destinations": {
        "Destination0": {
          "Address": "https+http://rest-api"
        }
      }
    }
  },
  "Routes": {
    "WebFrontend": {
      "ClusterId": "WebFrontend-Cluster",
      "Match": {
        "Path": "{**catch-all}"
      }
    },
    "RestApi": {
      "ClusterId": "RestApi-Cluster",
      "Match": {
        "Path": "/api/rest/{**remainder}"
      },
      "Transforms": [
        { "PathRemovePrefix": "/api/rest" }
      ]
    }
  },
  "AllowedHosts": "*"
}
